---
import { Icon } from 'astro-icon/components';
import WhatsAppIcon from '@/components/WhatsAppIcon.astro';
---

<footer class="footer">
  <div class="container footer-cta" data-reveal>
    <div>
      <p class="section-kicker spotlight-text">Atendimento imediato e sigiloso</p>
      <h2 class="spotlight-text">Seu caso exige uma defesa<br /><span>à altura.</span></h2>
    </div>
    <a class="button button-primary button-large" href="https://wa.me/5511999999999" target="_blank" rel="noreferrer"><WhatsAppIcon /> Falar com especialista</a>
  </div>
  <div class="container footer-main">
    <div class="footer-brand">
      <img class="brand-logo" src="/images/eduardo-ferreira-logo.svg" width="165" height="12" alt="Eduardo Ferreira" />
    </div>
    <p class="spotlight-text">Atuação estratégica em Direito Penal Econômico, com discrição, profundidade técnica e acompanhamento pessoal.</p>
    <div class="footer-links">
      <a href="#sobre">Quem somos</a>
      <a href="#especialidades">Especialidades</a>
      <a href="#diferenciais">Diferenciais</a>
      <a href="#faq">Dúvidas</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Ferreira Defesa. Todos os direitos reservados.</span>
    <span>OAB/SP nº 000.000</span>
    <a href="#inicio">Voltar ao topo <Icon name="lucide:arrow-up" aria-hidden="true" /></a>
  </div>
</footer>

<aside class="whatsapp-contact" data-whatsapp-contact aria-label="Atendimento pelo WhatsApp">
  <div class="whatsapp-invite" id="whatsapp-menu" data-whatsapp-invite>
    <button class="whatsapp-invite-close" type="button" aria-label="Fechar convite" data-whatsapp-close>
      <Icon name="lucide:x" aria-hidden="true" />
    </button>
    <img src="/images/eduardo-ferreira-560.webp" width="48" height="48" alt="" loading="lazy" decoding="async" />
    <div>
      <strong>Dr. Eduardo Ferreira</strong>
      <p>Olá! Precisa de orientação? Vamos conversar pelo WhatsApp.</p>
    </div>
    <a class="whatsapp-invite-action" href="https://wa.me/5511999999999" target="_blank" rel="noreferrer">
      <WhatsAppIcon />
      Iniciar conversa
    </a>
  </div>

  <button class="floating-whatsapp" type="button" aria-label="Abrir atendimento pelo WhatsApp" aria-expanded="false" aria-controls="whatsapp-menu">
    <WhatsAppIcon />
  </button>
</aside>
