---
import ArrowUpRightIcon from '@/components/ArrowUpRightIcon.astro';
import { siteConfig } from '@/config/site';

const { contact, faqSection: section } = siteConfig;
---

<section class="section faq" id={section.id}>
  <div class="container faq-grid">
    <div class="faq-intro" data-reveal>
      <p class="section-kicker">{section.eyebrow}</p>
      <h2 class="spotlight-text">{section.title} <span>{section.highlightedTitle}</span></h2>
      <p class="spotlight-text">{section.description}</p>
      <a class="arrow-link" href={contact.whatsappUrl} target="_blank" rel="noreferrer"><ArrowUpRightIcon /> {section.ctaLabel}</a>
    </div>

    <div class="faq-list" data-faq-list>
      {section.items.map(({ question, answer }, index) => (
        <details data-reveal open={index === 0}>
          <summary><span>{question}</span><i aria-hidden="true"></i></summary>
          <div class="faq-answer"><p>{answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
