---
import { Icon } from 'astro-icon/components';
import WhatsAppIcon from '@/components/WhatsAppIcon.astro';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <img src="/images/hero-legal.png" alt="" fetchpriority="high" />
  </div>
  <div class="container hero-inner">
    <div class="hero-copy" data-reveal>
      <div class="trust-pill">
        <span class="trust-avatars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>100% clientes atendidos com excelência</span>
      </div>
      <h1 id="hero-title">Defesa Estratégica em <em>Crimes Financeiros</em> e <em>Corrupção</em></h1>
      <p class="hero-lead">Atuação técnica e estratégica na defesa de empresários, executivos e pessoas investigadas em crimes financeiros complexos.</p>
      <div class="hero-actions">
        <a class="button button-primary button-large" href="https://wa.me/5511999999999" target="_blank" rel="noreferrer">
          <WhatsAppIcon />
          Quero defesa de alto nível
        </a>
        <a class="text-link" href="#sobre">Conheça nossa atuação <Icon name="lucide:arrow-down" aria-hidden="true" /></a>
      </div>
    </div>
  </div>
  <a class="scroll-cue" href="#numeros" aria-label="Ir para os números"><span></span></a>
</section>
