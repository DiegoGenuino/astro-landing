---
import { Icon } from 'astro-icon/components';
import WhatsAppIcon from '@/components/WhatsAppIcon.astro';
import { siteConfig } from '@/config/site';

const { contact, hero } = siteConfig;
const heroSrcset = hero.image.srcset.map(({ src, width }) => `${src} ${width}w`).join(', ');
---

<section class="hero" id={hero.id} aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source
        type="image/webp"
        srcset={heroSrcset}
        sizes={hero.image.sizes}
      />
      <img
        src={hero.image.src}
        width={hero.image.width}
        height={hero.image.height}
        alt={hero.image.alt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="trust-pill">
        <span class="trust-avatars" aria-hidden="true">{hero.trust.avatars.map((avatar) => <i style={`background-image: url("${avatar}")`}></i>)}</span>
        <span>{hero.trust.text}</span>
      </div>
      <h1 id="hero-title" data-hero-headline>{hero.title.map((part) => part.highlighted ? <em>{part.text}</em> : part.text)}</h1>
      <p class="hero-lead" data-hero-description>{hero.description}</p>
      <div class="hero-actions">
        <a class="button button-primary button-large" href={contact.whatsappUrl} target="_blank" rel="noreferrer">
          <WhatsAppIcon />
          {hero.primaryCtaLabel}
        </a>
        <a class="text-link" href={hero.secondaryCta.href}>{hero.secondaryCta.label} <Icon name="lucide:arrow-down" aria-hidden="true" /></a>
      </div>
    </div>
  </div>
  <a class="scroll-cue" href={hero.scrollTarget} aria-label={hero.scrollLabel}><span></span></a>
</section>

<noscript>
  <style>
    [data-hero-headline], [data-hero-description] { visibility: visible; }
  </style>
</noscript>
