---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config/site';

const bioText = siteConfig.seo.professionalDescription;
const bioWords = bioText.split(' ');
---

<section class="section about" id="sobre">
  <div class="container about-grid">
    <figure class="profile-card" data-reveal>
      <picture>
        <source
          type="image/webp"
          srcset="/images/eduardo-ferreira-560.webp 560w, /images/eduardo-ferreira-1122.webp 1122w"
          sizes="(max-width: 780px) calc(100vw - 34px), 392px"
        />
        <img
          src="/images/eduardo-ferreira-560.webp"
          width="560"
          height="700"
          alt="Dr. Eduardo Ferreira, advogado criminalista"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption>
        <span>Dr. Eduardo Ferreira</span>
        <small>Criminalista | nº 000.000</small>
      </figcaption>
    </figure>

    <div class="about-copy" data-reveal>
      <p class="section-kicker spotlight-text">Dr. Eduardo Ferreira</p>
      <p class="about-bio" data-scroll-text>
        <span class="sr-only">{bioText}</span>
        {bioWords.map((word, index) => (
          <span class="reveal-word" aria-hidden="true">{word}{index < bioWords.length - 1 ? ' ' : ''}</span>
        ))}
      </p>
      <ul class="credentials">
        <li><Icon name="lucide:circle-check" aria-hidden="true" /><span>OAB/SP nº 000.000 — inscrito desde 2009</span></li>
        <li><Icon name="lucide:circle-check" aria-hidden="true" /><span>Pós-graduado em Direito Penal Econômico — FGV Direito SP</span></li>
        <li><Icon name="lucide:circle-check" aria-hidden="true" /><span>Membro da Comissão de Direito Penal Econômico OAB/SP</span></li>
      </ul>
    </div>
  </div>
</section>
