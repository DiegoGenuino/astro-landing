---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import { siteConfig } from '@/config/site';
import type { Props as SEOProps } from '@/components/SEO.astro';

interface Props extends SEOProps {}

const seoProps = Astro.props;
const heroImage = siteConfig.hero.image;
const heroSrcset = heroImage.srcset.map(({ src, width }) => `${src} ${width}w`).join(', ');
---

<!doctype html>
<html lang={siteConfig.seo.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={siteConfig.seo.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <SEO {...seoProps} />

    <link rel="icon" href={siteConfig.seo.favicon} type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      as="image"
      href={heroImage.src}
      imagesrcset={heroSrcset}
      imagesizes={heroImage.sizes}
      type="image/webp"
      fetchpriority="high"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
